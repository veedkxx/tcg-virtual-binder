# Dev local: arquivo SQLite (não precisa de token)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Produção (Vercel -> Settings -> Environment Variables):
# TURSO_DATABASE_URL=libsql://<seu-db>-<sua-org>.turso.io
# TURSO_AUTH_TOKEN=<token criado com: turso db tokens create <seu-db>>

# Porta do Express em dev (o Vite faz proxy de /api para cá)
PORT=3001
