# Dev local: arquivo SQLite (não precisa de token)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Produção (Vercel -> Settings -> Environment Variables):
# TURSO_DATABASE_URL=libsql://<seu-db>-<sua-org>.turso.io
# TURSO_AUTH_TOKEN=<token criado com: turso db tokens create <seu-db>>

# Login com Google (Google Cloud Console -> Credenciais -> ID do cliente OAuth, "Aplicativo da Web").
# URIs de redirecionamento autorizados:
#   http://localhost:5173/api/auth/google/callback
#   https://<seu-dominio>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública do app, sem barra no fim. Define o redirecionamento do Google e liga o atributo
# Secure dos cookies quando começa com https://.
# Dev: http://localhost:5173 (é o endereço do Vite, que repassa /api ao Express).
# Produção: o domínio da Vercel. Se omitida na Vercel, usa o domínio de produção do projeto.
APP_URL=http://localhost:5173

# Porta do Express em dev (o Vite faz proxy de /api para cá)
PORT=3001
